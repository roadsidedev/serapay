NODE_ENV=production
# Railway runtime only: use Neon’s pooled connection string, not an administrative direct URL.
NODE_ENV=production
DATABASE_URL=postgresql://<user>:<password>@<pooled-host>/<database>?sslmode=require
JWT_SECRET=<generate-a-long-random-server-secret>
# Optional legacy bootstrap credentials; per-user credentials are created from wallet signatures.
SERA_API_KEY=
SERA_API_SECRET=
SERA_API_BASE_URL=https://api.sera.cx/api/v1
# Generate with: openssl rand -hex 32
SERA_CREDENTIAL_ENCRYPTION_KEY=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
OWNER_PRIVY_DID=did:privy:<owner-user-id>
ALLOWED_ORIGIN=https://<your-vercel-domain>
